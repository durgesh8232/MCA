#include <stdio.h>
#include <stdlib.h>

struct node
{
    struct node *prev;
    int data;
    struct node *next;
};

/* CREATE */
struct node* CreateLL(int n)
{
    struct node *head = NULL, *temp = NULL, *newnode;

    for(int i = 1; i <= n; i++)
    {
        newnode = (struct node*)malloc(sizeof(struct node));

        printf("Enter data of %d node: ", i);
        scanf("%d", &newnode->data);

        newnode->prev = temp;
        newnode->next = NULL;

        if(head == NULL)
            head = newnode;
        else
            temp->next = newnode;

        temp = newnode;
    }

    return head;
}

/* INSERT */
struct node* insert(struct node *head, int data)
{
    struct node *newnode, *temp;

    newnode = (struct node*)malloc(sizeof(struct node));
    newnode->data = data;
    newnode->prev = NULL;
    newnode->next = NULL;

    if(head == NULL)
        head = newnode;
    else
    {
        temp = head;

        while(temp->next != NULL)
            temp = temp->next;

        temp->next = newnode;
        newnode->prev = temp;
    }

    return head;
}

/* DELETE */
struct node* deleteNode(struct node *head, int data)
{
    struct node *temp = head;

    while(temp != NULL && temp->data != data)
        temp = temp->next;

    if(temp == NULL)
    {
        printf("Data not found.\n");
        return head;
    }

    if(temp->prev != NULL)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if(temp->next != NULL)
        temp->next->prev = temp->prev;

    free(temp);
    printf("Node deleted.\n");

    return head;
}

/* SEARCH */
void search(struct node *head, int data)
{
    int position = 1;

    while(head != NULL)
    {
        if(head->data == data)
        {
            printf("Data found at position %d.\n", position);
            return;
        }

        head = head->next;
        position++;
    }

    printf("Data not found.\n");
}

/* REVERSE */
struct node* reverse(struct node *head)
{
    struct node *temp = NULL, *current = head;

    while(current != NULL)
    {
        temp = current->prev;
        current->prev = current->next;
        current->next = temp;

        current = current->prev;
    }

    if(temp != NULL)
        head = temp->prev;

    return head;
}

/* DISPLAY */
void display(struct node *head)
{
    printf("Linked List: ");

    while(head != NULL)
    {
        printf("%d <-> ", head->data);
        head = head->next;
    }

    printf("NULL\n");
}

/* MAIN */
int main()
{
    int n, choice, data;
    struct node *head = NULL;

    printf("Enter size of list: ");
    scanf("%d", &n);

    head = CreateLL(n);

    while(1)
    {
        printf("\n1. Insert\n");
        printf("2. Delete\n");
        printf("3. Search\n");
        printf("4. Reverse\n");
        printf("5. Display\n");
        printf("6. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter data: ");
                scanf("%d", &data);
                head = insert(head, data);
                display(head);
                break;

            case 2:
                printf("Enter data to delete: ");
                scanf("%d", &data);
                head = deleteNode(head, data);
                display(head);
                break;

            case 3:
                printf("Enter data to search: ");
                scanf("%d", &data);
                search(head, data);
                break;

            case 4:
                head = reverse(head);
                display(head);
                break;

            case 5:
                display(head);
                break;

            case 6:
                printf("Program ended.\n");
                exit(0);

            default:
                printf("Invalid choice.\n");
        }
    }

    return 0;
}
